if(NOT DEFINED MPS_SOURCE_DIR)
    message(FATAL_ERROR "MPS_SOURCE_DIR is required")
endif()

set(slider_ini "${MPS_SOURCE_DIR}/Meshes/actors/character/facegenmorphs/RaceMenu.esp/sliders/Trixter.ini")
set(translation "${MPS_SOURCE_DIR}/interface/translations/racemenu_english.txt")
foreach(required_path IN ITEMS "${slider_ini}" "${translation}")
    if(NOT EXISTS "${required_path}")
        message(FATAL_ERROR "COtR safety asset is missing: ${required_path}")
    endif()
endforeach()

file(STRINGS "${slider_ini}" ini_lines ENCODING UTF-8)
set(current_section "")
set(male_entries)
set(female_entries)
foreach(line IN LISTS ini_lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "[Male]")
        set(current_section "male")
    elseif(line STREQUAL "[Female]")
        set(current_section "female")
    elseif(line MATCHES "^([^#][^=]+)=[^,]+,[ \t]*(Slider|Preset|HeadPart)")
        string(STRIP "${CMAKE_MATCH_1}" slider_name)
        set(entry "${slider_name}|${CMAKE_MATCH_2}")
        if(current_section STREQUAL "male")
            list(APPEND male_entries "${entry}")
        elseif(current_section STREQUAL "female")
            list(APPEND female_entries "${entry}")
        endif()
    endif()
endforeach()

list(SORT male_entries)
list(SORT female_entries)
list(LENGTH male_entries male_count)
list(LENGTH female_entries female_count)
if(male_count LESS 1 OR female_count LESS 1)
    message(FATAL_ERROR "Trixter.ini male/female slider sections were not parsed")
endif()
if(male_count LESS female_count)
    set(compare_count ${male_count})
else()
    set(compare_count ${female_count})
endif()
math(EXPR last_index "${compare_count} - 1")
foreach(index RANGE 0 ${last_index})
    list(GET male_entries ${index} male_entry)
    list(GET female_entries ${index} female_entry)
    string(REGEX REPLACE "^.*\\|" "" male_type "${male_entry}")
    string(REGEX REPLACE "^.*\\|" "" female_type "${female_entry}")
    if(NOT male_type STREQUAL female_type)
        message(
            FATAL_ERROR
            "Cross-sex SKEE type collision at sorted index ${index}: male=${male_entry}, female=${female_entry}"
        )
    endif()
endforeach()

foreach(required_key IN ITEMS "A1_RM_FacePart" "A2_EAR_EarShapeElf")
    string(FIND "${male_entries}" "${required_key}|" male_key_offset)
    string(FIND "${female_entries}" "${required_key}|" female_key_offset)
    if(male_key_offset EQUAL -1 OR female_key_offset EQUAL -1)
        message(FATAL_ERROR "Pinned COtR key is not present in both sections: ${required_key}")
    endif()
endforeach()

file(READ "${translation}" translation_prefix_hex HEX LIMIT 2)
string(TOLOWER "${translation_prefix_hex}" translation_prefix_hex)
if(NOT translation_prefix_hex STREQUAL "fffe")
    message(FATAL_ERROR "RaceMenu translation must remain UTF-16 LE with BOM")
endif()
